rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && role() == "Administrator";
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update, delete: if isAdmin();
    }

    match /cases/{caseId} {
      allow read: if signedIn();
      allow create: if signedIn() && role() in ["Administrator", "Direktor", "Leitung", "Ermittler", "Agent"];
      allow update: if signedIn() && role() in ["Administrator", "Direktor", "Leitung", "Ermittler"];
      allow delete: if isAdmin();
    }
  }
}

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /case-files/{caseId}/{allPaths=**} {
      allow read, write: if signedIn();
    }
  }
}
